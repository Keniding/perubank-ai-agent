# ============================================================
# PeruBank AI Agent - Environment Variables
# ============================================================

# AMD Developer Cloud - vLLM Endpoint
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=not-needed
VLLM_MODEL=meta-llama/Llama-3.3-70B-Instruct

# Alternative: Use cloud endpoint
# VLLM_BASE_URL=http://<your-amd-droplet-ip>:8000/v1

# Application Settings
APP_NAME=PeruBank AI Agent
APP_VERSION=1.0.0
APP_ENV=development
APP_PORT=8080
APP_HOST=0.0.0.0

# Agent Configuration
MAX_AGENT_ITERATIONS=5
AGENT_TIMEOUT_SECONDS=30
DEFAULT_TEMPERATURE=0.1
MAX_TOKENS=4096

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Database (optional - for persistence)
# DATABASE_URL=postgresql://user:pass@localhost:5432/perubank

# External APIs (optional)
# SBS_API_URL=https://api.sbs.gob.pe/v1
# RENIEC_API_URL=https://api.reniec.gob.pe/v1

# MongoDB Atlas
MONGODB_URI=mongodb+srv://develop-user:<password>@cluster0.j3c0b.mongodb.net/<database>
MONGODB_DB_NAME=perubank
